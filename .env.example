# Host bind address and port (loopback by default for reverse proxy on same host).
BIND_ADDR=127.0.0.1
APP_PORT=8080

# Household defaults
APP_CURRENCY=EUR
APP_CURRENCY_SYMBOL=€
APP_TIMEZONE=Europe/Athens

# Local Tesseract OCR languages, timeout, and per-household receipt quota
OCR_LANGUAGES=ell+eng
OCR_TIMEOUT_SECONDS=25
MAX_HOUSEHOLD_RECEIPTS_MB=250

# Master Key Encryption Key (KEK), versioned base64 32-byte key.
# Generate with: openssl rand -base64 32
# Format: v1:<base64> (or comma-separated v1:<old>,v2:<new> during rotation)
# Prefer MASTER_KEY_FILE=/run/secrets/tefteri_master_key in production.
MASTER_KEY=

# Public HTTPS WebAuthn / Passkey Relying Party configuration
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost:8080

# Enrollment policy: invite_only or closed
REGISTRATION_MODE=invite_only

# Cookie Secure flag and trusted reverse proxy IP
COOKIE_SECURE=auto
TRUSTED_PROXY=
