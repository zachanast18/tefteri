# Host bind address and port (loopback by default for reverse proxy on same VM).
# For a reverse proxy on a separate host, set BIND_ADDR to the VM's private LAN/WireGuard IP.
BIND_ADDR=127.0.0.1
APP_PORT=8080

# Household defaults
APP_CURRENCY=EUR
APP_CURRENCY_SYMBOL=€
APP_TIMEZONE=Europe/Athens

# Local Tesseract OCR languages and timeout
OCR_LANGUAGES=ell+eng
OCR_TIMEOUT_SECONDS=25

# Cookie Secure flag: auto (checks X-Forwarded-Proto/TLS), true, or false
COOKIE_SECURE=auto
